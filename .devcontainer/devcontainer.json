{
  "name": "SCAdmin",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": { "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" } },
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "SCAdmin", "onAutoForward": "silent" } },
  "containerEnv": { "PORT": "8080", "HOST": "0.0.0.0" },
  "postStartCommand": "setsid nohup node server.js > /tmp/scadmin.log 2>&1 < /dev/null &"
}
